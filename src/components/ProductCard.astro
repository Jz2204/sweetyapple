---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  description?: string;
  price: number;
  imageSrc: ImageMetadata;
  isStartingPrice?: boolean;
  href: string;
}

const { name, description, price, imageSrc, isStartingPrice = false, href } = Astro.props;
---

<article class="group relative flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
  <div class="aspect-square overflow-hidden bg-sweety-cream/50 relative">
    <Image 
      src={imageSrc} 
      alt={`Photo de ${name}`} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
      width={400}
      height={400}
    />
  </div>
  
  <div class="p-5 flex flex-col flex-grow">
    <h3 class="text-xl font-semibold mb-1">{name}</h3>
    {description && <p class="text-sweety-brown/70 text-sm mb-4 line-clamp-2">{description}</p>}
    
    <div class="mt-auto flex items-center justify-between">
      <span class="font-display text-lg text-sweety-caramel font-semibold">
        {isStartingPrice ? 'À partir de ' : ''}{price.toFixed(2)} €
      </span>
      <a 
        href={href}
        class="inline-flex items-center justify-center bg-sweety-brown text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-sweety-red transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-sweety-red focus:ring-offset-2 focus:ring-offset-white"
        aria-label={`Commander ${name}`}
      >
        Commander
      </a>
    </div>
  </div>
</article>