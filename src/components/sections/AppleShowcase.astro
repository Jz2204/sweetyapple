---
import { Image } from "astro:assets";
import { appleFlavours } from "../../data/flavours";

import redApple from "../../assets/images/pomme-rouge.webp";
import pinkApple from "../../assets/images/pomme-rose.webp";
import greenApple from "../../assets/images/pomme-verte.webp";
import turquoiseApple from "../../assets/images/pomme-turquoise.webp";

const startingPrice = Math.min(...appleFlavours.map((flavour) => flavour.price));
const formatPrice = (price: number) =>
  new Intl.NumberFormat("fr-BE", { style: "currency", currency: "EUR" }).format(price);
---

<section
  aria-labelledby="apple-showcase-title"
  class="bg-sweety-cream px-6 py-20 text-sweety-brown sm:px-10 lg:px-16 lg:py-28 xl:px-24"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div>
        <p class="mb-5 font-body text-xs font-semibold uppercase tracking-[0.22em] text-sweety-red">
          Les pommes d'amour
        </p>
        <h2
          id="apple-showcase-title"
          class="max-w-3xl font-display text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
        >
          La tentation
          <em class="block font-normal text-sweety-red">en couleurs.</em>
        </h2>
      </div>
      <div class="max-w-md lg:justify-self-end">
        <p class="font-body text-base leading-8 text-sweety-brown/80">
          Des pommes brillantes, des couleurs vibrantes et une collection de
          saveurs à découvrir. À vous de trouver votre préférée.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 font-body text-sm">
          <span class="font-semibold">{appleFlavours.length} saveurs</span>
          <span aria-hidden="true" class="h-1 w-1 rounded-full bg-sweety-red"></span>
          <span>Dès {formatPrice(startingPrice)}</span>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-3 lg:grid-cols-[0.93fr_1.07fr] lg:gap-5">
      <!-- Signature visual: the red apple anchors the brand palette. -->
      <figure class="relative aspect-[4/5] overflow-hidden bg-[#F4EEE8]">
        <Image
          src={redApple}
          alt="Pomme d'amour rouge brillante, parsemée de cristaux de sucre et surmontée d'une décoration multicolore"
          widths={[400, 600, 900, 1122]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          format="webp"
          quality={82}
          loading="lazy"
          class="h-full w-full object-cover"
        />
        <figcaption class="absolute bottom-5 left-5 bg-sweety-cream px-4 py-3 font-body text-[11px] font-semibold uppercase tracking-[0.15em] text-sweety-brown sm:bottom-7 sm:left-7">
          01 / La collection
        </figcaption>
      </figure>

      <div class="grid grid-rows-[auto_auto] gap-3 lg:gap-5">
        <div class="grid grid-cols-2 gap-3 lg:gap-5">
          <figure class="aspect-[4/5] overflow-hidden bg-[#F4EEE8]">
            <Image
              src={pinkApple}
              alt="Pomme d'amour rose, recouverte de petits éclats roses et surmontée de barbe à papa"
              widths={[240, 400, 640]}
              sizes="(min-width: 1024px) 25vw, 50vw"
              format="webp"
              quality={82}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </figure>
          <figure class="aspect-[4/5] overflow-hidden bg-[#F4EEE8]">
            <Image
              src={greenApple}
              alt="Pomme d'amour verte brillante avec éclats sucrés et décoration rouge et verte"
              widths={[240, 400, 640]}
              sizes="(min-width: 1024px) 25vw, 50vw"
              format="webp"
              quality={82}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </figure>
        </div>

        <figure class="relative aspect-[2.2/1] overflow-hidden bg-[#F4EEE8]">
          <Image
            src={turquoiseApple}
            alt="Gros plan d'une pomme d'amour turquoise, décorée de cristaux de sucre et de bonbons bleus"
            widths={[400, 640, 900, 1122]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            format="webp"
            quality={82}
            loading="lazy"
            class="h-full w-full object-cover object-[center_53%]"
          />
          <figcaption class="absolute bottom-4 left-4 bg-sweety-cream px-3 py-2 font-body text-[10px] font-semibold uppercase tracking-[0.14em] text-sweety-brown sm:bottom-6 sm:left-6">
            Des détails à croquer
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-6 border-t border-sweety-brown/20 pt-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-lg font-body text-sm leading-7 text-sweety-brown/75">
        Découvrez les saveurs acidulées et non acidulées, avec leurs prix et options.
      </p>
      <a
        href="/saveurs/"
        class="inline-flex min-h-12 shrink-0 items-center justify-center gap-3 self-start rounded-full bg-sweety-red px-7 py-3 font-body text-sm font-semibold text-white transition-colors duration-200 hover:bg-sweety-brown focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sweety-red motion-reduce:transition-none"
      >
        Découvrir les {appleFlavours.length} saveurs
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>
    </div>
  </div>
</section>
