---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

import {
  orderingRules,
  appleOrderRules,
  grapePricing,
  loveStrawberryPricing,
} from "../data/ordering";
---

<BaseLayout
  title="Commander chez Sweety Apple à Bruxelles"
  description="Découvrez comment commander chez Sweety Apple : délais, quantités, retrait à Molenbeek, livraison, acompte et conditions de modification."
>
  <main class="bg-sweety-cream font-body text-sweety-brown">

    <!-- INTRO -->
    <section class="px-6 pb-14 pt-14 sm:px-10 sm:pb-20 sm:pt-20 lg:px-12">
      <div
        class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-end lg:gap-16"
      >
        <div>
          <p
            class="mb-5 text-xs font-semibold uppercase tracking-[0.16em] text-sweety-red"
          >
            Commander chez Sweety Apple
          </p>

          <h1
            class="max-w-[11ch] font-display text-[clamp(3rem,5vw,4.8rem)] leading-[1.04] tracking-tight"
          >
            Votre commande, simplement.
          </h1>

          <p
            class="mt-6 max-w-lg text-base leading-8 text-sweety-brown/80 sm:text-lg"
          >
            Choisissez vos gourmandises, prévoyez quelques jours à l'avance
            et confirmez votre commande avec un acompte.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={siteConfig.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Commander chez Sweety Apple via Instagram"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-sweety-red px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-sweety-brown focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sweety-red"
            >
              Commander

              <svg
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
                class="h-4 w-4"
              >
                <path
                  d="M4.25 11.75 11.75 4.25M6 4.25h5.75V10"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>

            <a
              href="/produits/"
              class="inline-flex min-h-12 items-center justify-center rounded-full border border-sweety-brown/30 px-7 py-3 text-sm font-semibold transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sweety-brown"
            >
              Voir les produits
            </a>
          </div>
        </div>

        <!-- Key information -->
        <div
          class="grid gap-px overflow-hidden rounded-[1.5rem] bg-sweety-brown/15 sm:grid-cols-3"
        >
          <div class="bg-[#F3E8DF] p-6">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.15em] text-sweety-red"
            >
              Délai
            </p>

            <p class="mt-3 font-display text-3xl">
              {orderingRules.notice.standardOrderDays.min}{" à "}
              {orderingRules.notice.standardOrderDays.max}{" jours"}
            </p>

            <p class="mt-2 text-sm leading-6 text-sweety-brown/70">
              Pour une commande classique.
            </p>
          </div>

          <div class="bg-[#F3E8DF] p-6">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.15em] text-sweety-red"
            >
              Retrait
            </p>

            <p class="mt-3 font-display text-3xl">
              Molenbeek
            </p>

            <p class="mt-2 text-sm leading-6 text-sweety-brown/70">
              Entre Simonis et Belgica.
            </p>
          </div>

          <div class="bg-[#F3E8DF] p-6">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.15em] text-sweety-red"
            >
              Confirmation
            </p>

            <p class="mt-3 font-display text-3xl">
              Acompte
            </p>

            <p class="mt-2 text-sm leading-6 text-sweety-brown/70">
              Par virement bancaire.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section
      aria-labelledby="steps-title"
      class="border-t border-sweety-brown/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-12"
    >
      <div class="mx-auto max-w-6xl">

        <div class="mb-12 max-w-xl">
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-sweety-red"
          >
            Comment ça marche ?
          </p>

          <h2
            id="steps-title"
            class="font-display text-3xl leading-tight sm:text-4xl"
          >
            Trois étapes suffisent.
          </h2>
        </div>

        <ol class="grid border-t border-sweety-brown/25 md:grid-cols-3">
          <li
            class="border-b border-sweety-brown/20 py-8 md:border-b-0 md:border-r md:pr-8"
          >
            <p class="text-xs font-semibold text-sweety-red">
              01
            </p>

            <h3 class="mt-6 font-display text-2xl">
              Choisissez
            </h3>

            <p class="mt-3 max-w-sm text-sm leading-7 text-sweety-brown/75">
              Découvrez les produits et les saveurs qui vous donnent envie.
            </p>
          </li>

          <li
            class="border-b border-sweety-brown/20 py-8 md:border-b-0 md:border-r md:px-8"
          >
            <p class="text-xs font-semibold text-sweety-red">
              02
            </p>

            <h3 class="mt-6 font-display text-2xl">
              Organisez
            </h3>

            <p class="mt-3 max-w-sm text-sm leading-7 text-sweety-brown/75">
              Choisissez une date selon les disponibilités et prévoyez
              {" "}
              {orderingRules.notice.standardOrderDays.min}
              {" à "}
              {orderingRules.notice.standardOrderDays.max}
              {" "}
              jours d'avance.
            </p>
          </li>

          <li class="py-8 md:pl-8">
            <p class="text-xs font-semibold text-sweety-red">
              03
            </p>

            <h3 class="mt-6 font-display text-2xl">
              Confirmez
            </h3>

            <p class="mt-3 max-w-sm text-sm leading-7 text-sweety-brown/75">
              Un acompte par virement bancaire permet de bloquer définitivement
              votre commande.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- APPLE ORDER RULES -->
    <section
      aria-labelledby="apple-rules-title"
      class="bg-[#F1E4D8] px-6 py-16 sm:px-10 sm:py-20 lg:px-12"
    >
      <div
        class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16"
      >
        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-sweety-red"
          >
            Pommes d'amour
          </p>

          <h2
            id="apple-rules-title"
            class="max-w-md font-display text-3xl leading-tight sm:text-4xl"
          >
            Composer plusieurs saveurs.
          </h2>

          <p class="mt-4 max-w-sm text-sm leading-7 text-sweety-brown/75">
            Les quantités minimales évoluent selon le nombre de saveurs
            sélectionnées.
          </p>
        </div>

        <div class="border-t border-sweety-brown/30">
          <div
            class="grid gap-4 border-b border-sweety-brown/20 py-6 sm:grid-cols-[10rem_1fr]"
          >
            <p class="font-semibold">
              1 saveur
            </p>

            <p class="text-sm leading-7 text-sweety-brown/75">
              Aucun minimum particulier.
            </p>
          </div>

          <div
            class="grid gap-4 border-b border-sweety-brown/20 py-6 sm:grid-cols-[10rem_1fr]"
          >
            <p class="font-semibold">
              Dès 2 saveurs
            </p>

            <p class="text-sm leading-7 text-sweety-brown/75">
              Minimum
              {" "}
              {appleOrderRules.twoOrMoreFlavours.minimumPerFlavour}
              {" "}
              pommes par saveur.
            </p>
          </div>

          <div
            class="grid gap-4 border-b border-sweety-brown/20 py-6 sm:grid-cols-[10rem_1fr]"
          >
            <p class="font-semibold">
              Jusqu'à 4
            </p>

            <p class="text-sm leading-7 text-sweety-brown/75">
              Le format
              {" "}
              <strong class="font-semibold text-sweety-brown">
                {appleOrderRules.upToFourFlavours.specialFormatAllowed}
              </strong>
              {" "}
              est également possible.
            </p>
          </div>

          <div
            class="grid gap-4 border-b border-sweety-brown/20 py-6 sm:grid-cols-[10rem_1fr]"
          >
            <p class="font-semibold">
              5 saveurs
            </p>

            <p class="text-sm leading-7 text-sweety-brown/75">
              Pour trois saveurs au minimum :
              {" "}
              <strong class="font-semibold text-sweety-brown">
                {appleOrderRules.fiveFlavours.minimumQuantityForAtLeastThreeFlavours}
                {" "}
                pommes
              </strong>.
              Les saveurs restantes doivent être commandées par minimum
              {" "}
              {appleOrderRules.fiveFlavours.minimumQuantityForRemainingFlavours}.
            </p>
          </div>

          <p class="mt-5 text-xs leading-6 text-sweety-brown/60">
            Maximum :
            {" "}
            {appleOrderRules.maximumFlavours}
            {" "}
            saveurs différentes par commande.
          </p>
        </div>
      </div>
    </section>

    <!-- OTHER PRODUCT RULES -->
    <section
      aria-labelledby="other-products-title"
      class="px-6 py-16 sm:px-10 sm:py-20 lg:px-12"
    >
      <div class="mx-auto max-w-6xl">

        <div class="mb-10 max-w-xl">
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-sweety-red"
          >
            Autres gourmandises
          </p>

          <h2
            id="other-products-title"
            class="font-display text-3xl leading-tight sm:text-4xl"
          >
            Quelques conditions à connaître.
          </h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2">

          <!-- Raisins -->
          <article
            class="rounded-[1.5rem] border border-sweety-brown/15 p-6 sm:p-8"
          >
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.15em] text-sweety-red"
            >
              Raisins d'amour
            </p>

            <h3 class="mt-3 font-display text-2xl">
              Sachets & barquettes
            </h3>

            <ul class="mt-6 divide-y divide-sweety-brown/15">
              {
                grapePricing.bags.map((bag) => (
                  <li
                    class="flex justify-between gap-6 py-3 text-sm"
                  >
                    <span>
                      Sachet de {bag.quantity} raisins
                    </span>

                    <strong>
                      {bag.price} €
                    </strong>
                  </li>
                ))
              }

              <li
                class="flex justify-between gap-6 py-3 text-sm"
              >
                <span>
                  Barquette de {grapePricing.tray.quantity} raisins
                </span>

                <strong>
                  {grapePricing.tray.price} €
                </strong>
              </li>
            </ul>

            <p class="mt-5 text-sm leading-7 text-sweety-brown/70">
              Les raisins doivent accompagner une commande de pommes,
              sauf à partir de
              {" "}
              {grapePricing.rules.standaloneMinimumBags}
              {" "}
              sachets minimum.
            </p>
          </article>

          <!-- Fraises -->
          <article
            class="rounded-[1.5rem] border border-sweety-brown/15 p-6 sm:p-8"
          >
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.15em] text-sweety-red"
            >
              Fraises d'amour
            </p>

            <h3 class="mt-3 font-display text-2xl">
              Box de {loveStrawberryPricing.box.quantity}
            </h3>

            <p class="mt-5 font-display text-3xl">
              {loveStrawberryPricing.box.price} €
            </p>

            <p class="mt-5 text-sm leading-7 text-sweety-brown/70">
              Un mix de deux saveurs est possible à partir de
              {" "}
              {loveStrawberryPricing.mixedFlavours.availableFromBoxes}
              {" "}
              boîtes.
            </p>

            <p class="mt-4 text-sm leading-7 text-sweety-brown/70">
              Pour une seule box, celle-ci doit être combinée avec une
              pomme d'amour ou au minimum deux sachets de raisins d'amour
              de la même saveur.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- PICKUP & DELIVERY -->
    <section
      aria-labelledby="pickup-title"
      class="bg-sweety-brown px-6 py-16 text-sweety-cream sm:px-10 sm:py-20 lg:px-12"
    >
      <div
        class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16"
      >
        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-[#FFB4AE]"
          >
            Réception de votre commande
          </p>

          <h2
            id="pickup-title"
            class="max-w-md font-display text-3xl leading-tight text-sweety-cream sm:text-4xl"
          >
            Retrait ou livraison.
          </h2>
        </div>

        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <h3 class="font-display text-2xl text-sweety-cream">
              Retrait
            </h3>

            <p class="mt-4 text-sm leading-7 text-sweety-cream/75">
              {orderingRules.pickup.locationDescription}
            </p>

            <ul class="mt-4 space-y-2 text-sm font-semibold">
              {
                orderingRules.pickup.timeSlots.map((slot) => (
                  <li>
                    {slot.start} – {slot.end}
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="font-display text-2xl text-sweety-cream">
              Livraison
            </h3>

            <p class="mt-4 text-sm leading-7 text-sweety-cream/75">
              La livraison est souvent possible selon le jour et l'heure.
              Le prix dépend de la distance.
            </p>

            <p class="mt-4 text-sm font-semibold">
              Minimum :
              {" "}
              {orderingRules.delivery.minimumProducts}
              {" "}
              produits.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PAYMENT & CHANGES -->
    <section
      aria-labelledby="payment-title"
      class="px-6 py-16 sm:px-10 sm:py-20 lg:px-12"
    >
      <div class="mx-auto max-w-6xl">

        <div class="mb-12 max-w-xl">
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-sweety-red"
          >
            Après votre demande
          </p>

          <h2
            id="payment-title"
            class="font-display text-3xl leading-tight sm:text-4xl"
          >
            Paiement, modification et annulation.
          </h2>
        </div>

        <div class="grid border-t border-sweety-brown/25 md:grid-cols-3">

          <div
            class="border-b border-sweety-brown/20 py-7 md:border-b-0 md:border-r md:pr-8"
          >
            <h3 class="font-display text-xl">
              Acompte
            </h3>

            <p class="mt-3 text-sm leading-7 text-sweety-brown/70">
              Un acompte par virement bancaire est obligatoire
              pour confirmer la commande.
            </p>
          </div>

          <div
            class="border-b border-sweety-brown/20 py-7 md:border-b-0 md:border-r md:px-8"
          >
            <h3 class="font-display text-xl">
              Solde
            </h3>

            <p class="mt-3 text-sm leading-7 text-sweety-brown/70">
              Le solde peut être réglé par virement avant réception
              ou en espèces.
            </p>
          </div>

          <div class="py-7 md:pl-8">
            <h3 class="font-display text-xl">
              Changement
            </h3>

            <p class="mt-3 text-sm leading-7 text-sweety-brown/70">
              Une modification est possible jusqu'à
              {" "}
              {orderingRules.modifications.allowedUntilHoursBefore}
              {" "}
              heures avant. En cas d'annulation, l'acompte n'est
              pas remboursé.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section
      class="bg-[#F1E4D8] px-6 py-14 sm:px-10 sm:py-16 lg:px-12"
      aria-labelledby="order-cta-title"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col gap-7 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-sweety-red"
          >
            Prêt à commander ?
          </p>

          <h2
            id="order-cta-title"
            class="max-w-xl font-display text-3xl leading-tight sm:text-4xl"
          >
            Envoyez votre demande à Sweety Apple.
          </h2>

          <p
            class="mt-4 max-w-xl text-sm leading-7 text-sweety-brown/70 sm:text-base"
          >
            Indiquez les produits, les saveurs, les quantités et la date
            souhaitée dans votre message.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="/saveurs/"
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-sweety-brown/30 px-7 py-3 text-sm font-semibold transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sweety-brown"
          >
            Voir les saveurs
          </a>

          <a
            href={siteConfig.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Commander chez Sweety Apple via Instagram"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-sweety-red px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-sweety-brown focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sweety-red"
          >
            Commander

            <svg
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              class="h-4 w-4"
            >
              <path
                d="M4.25 11.75 11.75 4.25M6 4.25h5.75V10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>